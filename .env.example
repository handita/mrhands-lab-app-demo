# ==============================================================================
# SUPABASE TARGET SWITCHER
# Pilihan: 'local' (Supabase Docker) atau 'cloud' (Supabase Hosted)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_MODE=local
VITE_SUPABASE_MODE=local

# ==============================================================================
# 1. SUPABASE LOKAL (Docker via Supabase CLI)
# ==============================================================================
LOCAL_URL=
LOCAL_ANON_KEY=
LOCAL_SERVICE_ROLE_KEY=
LOCAL_DATABASE_URL=

NEXT_PUBLIC_LOCAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_LOCAL_ANON_KEY=
VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
VITE_SUPABASE_LOCAL_ANON_KEY=

# ==============================================================================
# 2. SUPABASE CLOUD (Placeholder untuk Hosted Online)
# ==============================================================================
CLOUD_URL=https://[YOUR_PROJECT_REF].supabase.co
CLOUD_ANON_KEY=[YOUR_ANON_KEY]
CLOUD_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]
CLOUD_DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

NEXT_PUBLIC_CLOUD_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_CLOUD_ANON_KEY=[YOUR_ANON_KEY]
VITE_SUPABASE_CLOUD_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_SUPABASE_CLOUD_ANON_KEY=[YOUR_ANON_KEY]
